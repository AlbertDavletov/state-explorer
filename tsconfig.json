{
  "extends": "./packages/core/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDir": ".",
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx"
  },
  "include": ["packages/core/src/**/*.ts", "packages/core/test/**/*.ts", "packages/react/src/**/*.tsx", "packages/react/test/**/*.tsx", "packages/react/test/*.browser.ts", "examples/demo/*.tsx"]
}
